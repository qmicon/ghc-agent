<div data-section-id="{{ section.id }}" data-section-type="header-type-3" class="header-type-3">  

  {% if section.settings.display_top_bar %}    
  {% include 'top-bar-type-3' %}  
  {% endif %}  
  {% if section.settings.display_search %}    
  {% include 'search-bar-type-3' %}
  {% endif %}
  <header class="site-header">
    <div class="header-sticky">
      <div id="header-landing" class="sticky-animate">
       
          <div class="grid--full site-header__menubar"> 
            {% include 'logo' %}
            <div class="grid__item wide--five-sixths post-large--five-sixths large--five-sixths menubar-section">
              <div class="menu-tool medium-down--hide">
                {% include 'site-nav' %}
              </div>

              <div class="menu-icon">         

                {% if section.settings.display_search %}                
                <div class="header-search">
                  <a href="/search" class="site-header__link site-header__search js-drawer-open-top">
                    <span class="fa fa-search" aria-hidden="true"></span>
                  </a>
                </div>
                {% endif %}  
                <div class="header-bar__module cart header_cart">
                  {% if section.settings.display_minicart %}
                  {% include 'mini-cart' %} 
                  {% endif %} 
                </div> 
                {% if shop.customer_accounts_enabled or section.settings.display_wishlist %}
                <ul class="menu_bar_right">
                  <li>
                    <div class="slidedown_section">
                      <a  id="Togglemodal" class="icon-cart-arrow"><i class="fa fa-bars"></i></a>
                      <div id="slidedown-modal">
                        <div class="header-panel-top">

                          <div class="customer_account">                          
                            <ul>
                              {% if shop.customer_accounts_enabled %}
                              {% if customer %}
                              <li>
                                <a href="/account" title="{{ 'layout.customer.account' | t }}">{{ 'layout.customer.account' | t }}</a>
                              </li>
                              <li class="logout-link">
                                {{ 'layout.customer.log_out' | t | customer_logout_link }}
                              </li>
                              {% else %}
                              <li>
                                <a href="/account/login" title="{{ 'layout.customer.log_in' | t }}">{{ 'layout.customer.log_in' | t }}</a>
                              </li>
                              <li>
                                <a href="/account/register" title="{{ 'layout.customer.create_account' | t }}">{{ 'layout.customer.create_account' | t }}</a>
                              </li>          
                              {% endif %}  
                              {% endif %} 
                              {% if section.settings.display_wishlist %}   
                              <li>
                                {% include 'wish-list' %} 
                              </li>
                              {% endif %} 
                            </ul>
                          </div>    

                        </div>
                      </div>
                    </div>


                  </li>
                </ul>
                {% endif %} 
              </div>
            </div> 
          </div>
       
      </div>
    </div>
  </header>
  <div class="mobile-nav-section wide--hide post-large--hide large--hide">
    <button type="button" class="mobile-nav-trigger" id="MobileNavTrigger">
      <span class="icon-menu" aria-hidden="true"></span>    
    </button>  
  </div>
  {% include 'mobile-nav' %}
  <style> 
    /* Top block */
    .header-type-3 .top_bar { background: {{ section.settings.top_bar_bg }}; }
    .header-type-3 .top_bar::after, .header-type-3 .top_bar::before{background: {{ section.settings.top_bar_bg }};}
    .header-type-3 .top_bar li, .header-type-3 .top_bar span { color:{{section.settings.top_bar_text}};}   
    .header-type-3 .top_bar a { color:{{section.settings.top_bar_links }};}    
    .header-type-3 .top_bar a:hover, .header-type-3 .top_bar a:hover span { color:{{section.settings.top_bar_link_hover }};}    
    .header-type-3 .header-bar__module.cart .baskettop a.icon-cart-arrow #cartCount { background: {{ section.settings.minicart_count_bg }};color:{{section.settings.minicart_count }};}
    .header-type-3 .header-bar__module.cart .baskettop a.icon-cart-arrow:hover #cartCount { background: {{ section.settings.minicart_count_hover_bg }};color:{{section.settings.minicart_count_hover_text }};}


    /* Logo block */
    .header-type-3 .site-header__logo a { color:{{section.settings.logo_text }};}
    .header-type-3 .site-header__logo a:hover { color:{{section.settings.logo_hover_text }};}    

    /* Menu  block */
    .header-type-3 .site-header__menubar , .header-type-3 .mobile-nav-section{background: {{ section.settings.menubar_bg }};}
    .header-type-3 .menu-tool ul li {color: {{ section.settings.menubar_text }};}
    .header-type-3 .menu-tool ul li a , .header-type-3 .mobile-nav-trigger{color:{{section.settings.menubar_links}};}  
    .header-type-3 .menu-tool ul li a:hover,.header-type-3 .menu-tool .site-nav > li > a.current:hover{color:{{section.settings.menubar_links_hover}};} 
    .header-type-3 .menu-tool .site-nav >  li > a.current {color:{{section.settings.menu_active}};} 
    .header-type-3 .site-nav-dropdown , .header-type-3 .mobile-nav{ background: {{ section.settings.menubar_dropdown_bg }};}
    .header-type-3 .site-nav-dropdown .inner > a , .header-type-3 .mobile-nav__link > a.current {color: {{ section.settings.menubar_dropdown_caption }};}    
    .header-type-3 .site-nav-dropdown .inner > a:hover {color: {{ section.settings.menubar_dropdown_caption_hover }};}    
    .header-type-3 .site-nav-dropdown .inner .dropdown a,.header-type-3 .menu-tool .site-nav .site-nav-dropdown li a, .header-type-3 .mobile-nav__link > a {color: {{ section.settings.menubar_dropdown_links }};}
    .header-type-3 .site-nav-dropdown .inner .dropdown a:hover,.header-type-3 .menu-tool .site-nav .site-nav-dropdown li a:hover ,.header-type-3 .mobile-nav__link > a:hover {color: {{ section.settings.menubar_dropdown_links_hover }};}

    /* Dropdown block */
    .header-type-3 .menubar-section #Togglemodal i {color: {{ section.settings.dropdown_icon }};}
    .header-type-3 .menubar-section #Togglemodal i:hover {color: {{ section.settings.dropdown_icon_hover }};}
    .header-type-3 #slidedown-modal {background: {{ section.settings.dropdown_bg }};}
    .header-type-3 #slidedown-modal ul li a {color:{{section.settings.dropdown_link}};} 
    .header-type-3 #slidedown-modal ul li a:hover {color:{{section.settings.dropdown_hover_link}};} 


    /* Search block */     
    .header-type-3 .search-bar input[type="search"] {color:{{section.settings.search_text }};} 
    .header-type-3 .header-search span  {color:{{section.settings.search_icon}};} 
    .header-type-3 .header-search span:hover {color:{{section.settings.search_icon_hover }};} 
    .header-type-3 .search-bar__form, .header-type-3 #SearchDrawer  {  background:{{section.settings.search_bg }};}
    .header-type-3 .search-bar__form button,.header-type-3 .search-bar__icon-button { color:{{section.settings.search_link }};}
    .header-type-3 .search-bar__form button:hover,.header-type-3 .search-bar__icon-button:hover { color:{{section.settings.search_link_hover }};}

    .header-type-3 .search-bar input[type="search"]::-webkit-input-placeholder  { /* Chrome/Opera/Safari */
      color:{{ section.settings.search_text }};
    }
    .header-type-3 .search-bar input[type="search"]::-moz-placeholder { /* Firefox 19+ */
      color:{{ section.settings.search_text }};
    }
    .header-type-3 .search-bar input[type="search"]:-ms-input-placeholder { /* IE 10+ */
      color:{{ section.settings.search_text }};
    }
    .header-type-3 .search-bar input[type="search"]:-moz-placeholder { /* Firefox 18- */
      color:{{ section.settings.search_text }};
    }
    /* Cart Summary block */
    .header-type-3 a.icon-cart-arrow i  {color: {{ section.settings.minicart_icon }};}
    .header-type-3 a.icon-cart-arrow:hover i {color: {{ section.settings.minicart_icon_hover }};}
    .header-type-3 #slidedown-cart .actions, .header-type-3  #slidedown-cart  {background: {{ section.settings.minicart_bg }};}
    .header-type-3 .header-bar__module p {color: {{ section.settings.minicart_text }};}
    .header-type-3 .header-bar__module a {color:{{section.settings.minicart_link }};}  
    .header-type-3 .header-bar__module a:hover {color:{{section.settings.minicart_link_hover}};} 
    .header-type-3 .header-bar__module .btn {color:{{section.settings.minicart_btn_text}};background: {{ section.settings.minicart_btn_bg }};} 
    .header-type-3 .header-bar__module .btn:hover {color:{{section.settings.minicart_btn_hover_text}};background: {{ section.settings.minicart_btn_hover_bg }};} 
    .header-type-3  #slidedown-cart .total .price, .header-type-3 #minicart_total,.header-type-3 #slidedown-cart ul li .cart-collateral {color:{{section.settings.minicart_total }};} 
    .header-type-3 #slidedown-cart li { border-bottom:1px solid {{ section.settings.border_between_bars}}; }

    /* Currency block */

    .header-type-3 a.currency_wrapper.dropdown-toggle {color: {{ section.settings.currency_icon }};}
    .header-type-3 .tbl-list>li.currency>.dropdown-toggle:hover  {color: {{ section.settings.currency_icon_hover }};}
    .header-type-3 .tbl-list>li.currency .flag-dropdown-menu  {background: {{ section.settings.currency_bg }};}
    .header-type-3 .flag-dropdown-menu li a span {color: {{ section.settings.currency_link }};}
    .header-type-3 .flag-dropdown-menu li a:hover span {color:{{section.settings.currency_hover_link }};}  

    /* Header borders */
    .header-type-3 .site-nav>li>a:before {background: {{ section.settings.border_between_bars}}; }
    .header-type-3 .top_bar .top_bar_right li span,.header-type-3 .tbl-list>li.currency>.dropdown-toggle { border-right:1px solid {{ section.settings.top_border_between_bars }}; }
    .header-type-3 .top_bar ul li:last-child,.header-type-3 .top_bar .top_bar_right li:last-child span { border-right:none; }

  </style> 
</div>

