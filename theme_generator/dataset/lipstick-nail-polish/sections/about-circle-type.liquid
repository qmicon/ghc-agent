<div data-section-id="{{ section.id }}"  data-section-type="about-circle-type" class="about-circle-type">

  <div class="grid__item">

    <div class="about-icon-type">
      <div class="container">

        <div class="border-title wow fadeInDown animated">
          {% if section.settings.description_1 != blank %} <h5 class="small-title" style="color:{{ section.settings.desc_color }}">{{ section.settings.description_1 }}</h5>{% endif %}        
          {% if section.settings.title != blank %}
          <h2 style="color:{{section.settings.title_color}}">{{ section.settings.title }}</h2>

          {% if section.settings.title_img != blank %}
          <div class="tilte_img">
            <img src="{{ section.settings.title_img | img_url: '69x23' }}" alt="" title=""  />
          </div>
          {% endif %}
          {% endif %}

        </div>
        {% if section.blocks.size > 0 %}  
        {% for block in section.blocks %} 
        {% case section.blocks.size %}
        {% when 1 %}
        {%- assign block_width = 'one-whole text-center' -%}
        {% when 2 %}
        {%- assign block_width = 'wide--one-half post-large--one-third large--one-third medium--one-whole small-grid__item' -%}
        {% when 3 %}
        {%- assign block_width = 'wide--one-third post-large--one-third large--one-third medium--one-whole small-grid__item' -%}

        {% endcase %}
        <div class="grid__item {{ block_width }}">
          <div class="icon-img-wrapper wow fadeInUp animated">
            {% if block.settings.icon_img != blank %}
            <div class="icon-img">
              <img src="{{ block.settings.icon_img | img_url: '1024x1024' }}" alt="" title="" style="border:5px solid {{block.settings.img_border_clr}}"  /> 
            </div>
            {% endif %}
            {% if block.settings.icon_img_title != blank %}
            <h4 style="color:{{block.settings.icon_img_title}};">{{block.settings.icon_img_title }}</h4>
            {% endif %}
            {% if block.settings.icon_img_desc != blank %}
            <p style="color:{{block.settings.icon_desc_clr}};">{{block.settings.icon_img_desc }}</p>
            {% endif %}
          </div>
        </div>
        {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
  <div class="dt-sc-hr-invisible-large"></div>
</div>










<style>

  .about-circle-type h2::before{background:{{section.settings.hover_clr}};}

  .about-circle-type .icon-img-wrapper:hover h4{color:{{section.settings.hover_clr}};}

  .about-circle-type .icon-img-wrapper:hover img{border:5px solid {{section.settings.hover_clr}}!important;}

  .about-circle-type .icon-img::before {background: {{section.settings.hover_over_clr}};}
</style>








{% schema %}
{
"name": "About Circle Type",
"class": "index-section",
"settings": [
{
"type": "text",
"id": "title",
"label": "Heading"
},
{
"type": "color",
"id": "title_color",
"label": "Title Color",
"default":"#000"
},
{
"type": "image_picker",
"id": "title_img",
"label": "Title Image",
"info": "Size: 69x23"
},
{
"type": "textarea",
"id": "description_1",
"label": "Description"

},
{
"type": "color",
"id": "desc_color",
"label": "Color",
"default":"#000"
},
{
"type": "color",
"id": "hover_clr",
"label": "Hover Border Color",
"default":"#000"
},
{
"type": "color",
"id": "hover_over_clr",
"label": "Hover Overlay Color",
"default":"#000"
}
],
"blocks": [
{
"type": "Image",
"name":"About Circle Type",
"settings": [
{
"type": "image_picker",
"id": "icon_img",
"label": "Icon Image",
"info": "Size: 500x500"
},
{
"type": "color",
"id": "img_border_clr",
"label": "Image Border Color",
"default": "#000"
},
{
"type": "text",
"id": "icon_img_title",
"label": "Title",
"default": "Title"
},
{
"type": "textarea",
"id": "icon_img_desc",
"label": "Desc",
"default": "Title"
},
{
"type": "color",
"id": "icon_desc_clr",
"label": "Desc Color",
"default": "#000"
}
]
}
],
"presets": [
{
"name": "About Circle Type",
"category": "Image",
"blocks": [
{
"type": "Image"
},
{
"type": "Image"
}        
]
}
]
}
{% endschema %}
