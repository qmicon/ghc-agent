 $(document).ready(function(){
     var brand_logos = $("#client-carousel");
      brand_logos.owlCarousel({
       items:5,
       loop:false,      
       dots: true, 
	   autoplay: true,
 nav:false,
	   autoplayTimeout: 3000,
          responsive:{
           0:{
             items: 1
           },
           600:{
             items:2
           },
           700:{
             items:4
           },
           
           1000:{
             items: 5
           }
         }
  			});
        });
{% endjavascript %}

