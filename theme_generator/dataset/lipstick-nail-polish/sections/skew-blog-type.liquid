<div data-section-id="{{ section.id }}"  data-section-type="skew-blog-type" class="skew-blog-type">
  <div class="container">
    <div class="blog-post">
      <div class="grid">  
       {% if section.settings.title != blank %}
        <div class="border-title wow fadeInDown animated">
          {% if section.settings.description_1 != blank %} <h5 class="small-title" style="color:{{ section.settings.desc_color }}">{{ section.settings.description_1 }}</h5>{% endif %}        
          <h2 style="color:{{section.settings.title_color}}">{{ section.settings.title }}</h2>
           {% if section.settings.title_img != blank %}
          <div class="tilte_img">
            <img src="{{ section.settings.title_img | img_url: '69x23' }}" alt="" title=""  />
          </div>
          {% endif %}
        </div>
        {% endif %}
        <div class="home-blog blog-section owl-carousel owl-theme" id="SkewBlogType">        
          {% for article in blogs[section.settings.pick_featured_blog].articles   %}   
          <div class="article-item grid__item wow fadeInUp animated">
            <div class="article">
              <div class="home-blog-image grid__item">
                {% if article.image %}
                <a href="{{ article.url }}">
                  <img src="{{ article.image.src | img_url: 'grande' }}" alt="{{ article.title }}" />
                </a>
                {% endif %}
                <h4><a href="{{ article.url }}" style="color:{{ section.settings.blogtitle_clr }};">{{ article.title }}</a></h4>
              </div>
              <div class="blog-description grid__item">
                {% if section.settings.blog_description %}
                <p style="color:{{ section.settings.blog_desc_clr }};" class="blog-desc">{{ article.content | strip_html | truncate: 170 }}</p>
                {% endif %}
                <div class="home-blog-content blog-detail">
                  {% if article.comments_enabled? %}
                  {% assign number_of_comments = article.comments_count %}
                  {% if section.settings.blog_comment %}
                  <p class="comments-count">{{  number_of_comments }} {{ 'blogs.comments.comments' | t }}</p>
                  {% endif %}
                  {% endif %}
                  <p class="author" style="color:{{ section.settings.blog_author_text }}">
                    {% if section.settings.blog_author_enable %}            
                    <span> {{ article.author }}</span>
                    {% endif %}
                  </p>
                  {% if section.settings.btn != blank %}
                  <div class="blog-btn">
                    <a style="color:{{ section.settings.btn_txt }};"  href="{{ article.url }}">{{ section.settings.btn }}</a>
                  </div>
                  {% endif %}
                  {% if section.settings.show_featured_date %}   
                  <p class="blog-date" style="color:{{ section.settings.blog_date_clr }};">
                    <span>  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}"><span class="date"><i style="color:{{ section.settings.date_color }}">{{ article.published_at | date: '%d' }} </i> &#47; {{ article.published_at | date: '%b' }} </span></time>  </span>
                  </p>
                  {% endif %}  
                </div>
              </div>
            </div>  
          </div>
          {% else %}
          {% for i in (1..2) %}
          <div class="article-item grid__item">
            <div class="article">
              <div class="home-blog-image grid__item wide--one-half post-large--one-half large--one-half"> 
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="blog-description grid__item wide--one-half post-large--one-half large--one-half">  
                <div class="blogs-sub-title">
                  <p class="blog-date">
                    <time datetime="2016-11-01"><span class="date">Jan 01 , 2017</span></time>
                  </p>
                  <div class="home-blog-content blog-detail">
                    <h4><a href="#">Sample post {{ i }}</a></h4>
                    <p class="author">
                      <i class="zmdi zmdi-account"></i>
                      <span> Author Name</span>
                    </p>
                    <div class="blog-btn">
                      <a class="btn" href="#">Read more <i class="fa fa-angle-double-right" aria-hidden="true"></i></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
          {% endfor %}
        </div>
      </div>

      <style>
        .skew-blog-type .blog-detail h4 a:hover { color:{{ section.settings.title_hover_clr }} !important; }
        .skew-blog-type .blog-detail .blog-btn a:hover { color:{{ section.settings.btn_txt_hover }} !important; }
        .skew-blog-type .blog-detail .comments-count { color:{{ section.settings.blog_comment_text }}; }
        .skew-blog-type .comments-count:before { background:{{ section.settings.blog_comment_text }}; }
        .skew-blog-type .home-blog-image h4{background:{{ section.settings.title_bg_clr }};}
        .skew-blog-type .blog-detail .blog-date{background:{{section.settings.blog_date_bg}};}
        .skew-blog-type .home-blog-content.blog-detail{border-top:1px solid {{section.settings.border_clr}};}
        .skew-blog-type .blog-detail p::before { background:{{section.settings.border_clr}};}
        .skew-blog-type .home-blog-image h4::before{background:{{ section.settings.title_bg_clr }};}
        
        .skew-blog-type .article:hover .blog-detail .blog-date{background:{{section.settings.title_bg_clr}}!important;}
        
      </style>
    </div>
  </div>

  <div class="dt-sc-hr-invisible-large"></div>

</div>

{% schema %}
{
"name": "Featured blog post",
"settings": [
{
"type": "text",
"id": "title",
"label": "Heading"
},
{
"type": "color",
"id": "title_color",
"label": "Title Color",
"default":"#000"
},
{
"type": "image_picker",
"id": "title_img",
"label": "Title Image",
"info": "Size: 600x355"
},



{
"type": "textarea",
"id": "description_1",
"label": "Description"

},
{
"type": "color",
"id": "desc_color",
"label": "Color",
"default":"#000"
},
{
"type": "blog",
"id": "pick_featured_blog",
"label": "Select blog"
},
{
"type": "color",
"id": "title_bg_clr",
"label": "Blog Title Bg Color",
"default": "#000"
},
{
"type": "color",
"id": "blogtitle_clr",
"label": "Blog Title Color",
"default": "#000"
},
{
"type": "checkbox",
"id": "show_featured_date",
"label": "Show date"
},
{
"type": "color",
"id": "date_color",
"label": "Date Color",
"default": "#000"
},
{
"type": "color",
"id": "blog_date_clr",
"label": "Month Color",
"default": "#000"
},
{
"type": "color",
"id": "blog_date_bg",
"label": "Blog Date bg Color",
"default": "#000"
},

{
"type": "checkbox",
"id": "blog_author_enable",
"label": "Show author"
},
{
"type": "color",
"id": "blog_author_text",
"label": "Author Color",
"default": "#000"
},
{
"type": "checkbox",
"id": "blog_comment",
"label": "Show Comment"
},
{
"type": "color",
"id": "blog_comment_text",
"label": "Comment Color",
"default": "#000"
},
{
"type": "checkbox",
"id": "blog_description",
"label": "Show description"
},
{
"type": "color",
"id": "blog_desc_clr",
"label": "Description Color",
"default": "#000"
},
{
"type": "text",
"id": "btn",

"label": "Link",
"default": "Read more"
},
{
"type": "color",
"id": "btn_txt",
"label": "Link Text",
"default": "#000"
},
{
"type": "color",
"id": "btn_txt_hover",
"label": "Link Text Hover",
"default": "#000"
},
{
"type": "color",
"id": "border_clr",
"label": "Border Color",
"default": "#000"
}
],
"presets": [
{
"name": "Featured blog post",
"category": "blog"
}
]
}
{% endschema %}



<script type="text/javascript">
  $(document).ready(function(){
    SkewBlogType = $("#SkewBlogType");
    SkewBlogType.owlCarousel({
      loop:false,
      margin:10,
      autoPlay: false,
      nav:false,
      // navContainer: ".skew-blog-type .nav_article",
      //  navText: ['<a class="prev btn"><i class="fa fa-angle-left" ></i></a>','<a class="next btn"><i class="fa fa-angle-right" ></i></a>'],
      dots: true,
      responsive:{
        0:{
          items:1
        },
        600:{
          items:1
        },
        720:{
          items:2
        }
      }
    });   
  }); 

</script>