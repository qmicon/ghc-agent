<div data-section-id="{{ section.id }}"  data-section-type="client section" class="client-section">
 {% if section.blocks.size > 0 %}    
  <div class="grid-uniform section-seven">
      <div class="grid__item">
        <div class="border-title">
        {% if section.settings.title != blank %}
        <h2 style="color:{{ section.settings.title_color }};">{{ section.settings.title }}</h2>
        {% endif %}
        </div>
        <div id="client-car" class="owl-carousel client-section">
          {% for block in section.blocks %}
          {% if block.settings.client_img != blank %}
          <div class="item">
            <a href="{{ block.settings.client_link }}"> <img src="{{ block.settings.client_img | img_url: "master"  }}" alt="{{ block.settings.client_heading }}" /></a>
          </div>
          {% else %}          
          <div class="item"><a href="#">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</a></div>
           {% endif %}           
          {% endfor %}
        </div>
      </div>
  </div>
  <div class="dt-sc-hr-invisible-large"></div>
  {% endif %} 
</div>

{% schema %}
{
"name": "Client Logo",
"class": "index-section",
"settings": [
	{
"type": "text",
"id": "title",
"label": "Heading"
},
{
"type": "color",
"id": "title_color",
"label": "Color"
}

],
"blocks": [
{
"type": "Image",
"name":"client img",
"settings": [
{
"type": "image_picker",
"id": "client_img",
"label": "Image",
"info": "Size: 170x170"
},
{
"type": "text",
"id": "client_heading",
"label": " Alt Text",
"default": "Brand"
},
{
"type": "text",
"id": "client_link",
"label": "Link URL",
"default": "#"
}
]
}
],

"presets": [
{
  "name": "Client Logo",
"category": "Image",
      "blocks": [
        {
          "type": "Image"
        },
        {
          "type": "Image"
        },
		{
          "type": "Image"
        },
		{
          "type": "Image"
        },
        {
          "type": "Image"
        },
		{
          "type": "Image"
        },{
          "type": "Image"
        },
        {
          "type": "Image"
        },
		{
          "type": "Image"
        }
 		
      ]
}
]
}
{% endschema %}



{% javascript %}



$(document).ready(function() {

//Sort random function
function random(owlSelector){
owlSelector.children().sort(function(){
return Math.round(Math.random()) - 0.5;
}).each(function(){
$(this).appendTo(owlSelector);
});
}

