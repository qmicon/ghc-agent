  outline: none;
  font-size: 16px;
  font-weight: 600;
  transition: 0.4s;
  border-radius: 0px !important;
  
}

.active, .accordion:hover {
/*   background-color: #efefef; */
}

.accordion:after {
  content: url(https://cdn.shopify.com/s/files/1/0477/0345/7956/files/down_20.png?v=1684866554);
    /* color: #777; */
