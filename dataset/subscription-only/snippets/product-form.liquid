  const buyNowButton = document.getElementById("buyNow");
const loader = document.getElementById("loader");

buyNowButton.addEventListener("click", function () {
  // Show the loader
  loader.style.display = "block";

  // Simulate a delay (you can replace this with your actual loading process)
  setTimeout(function () {
	// Hide the loader (when your loading is done)
	loader.style.display = "none";
  }, 3000); // Change 2000 to the actual loading time in milliseconds
});

var supplementDialog = document.createElement("dialog");
