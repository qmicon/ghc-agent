supplementImg.src = "https://cdn.shopify.com/s/files/1/0632/5439/7077/files/nitric_oxide_supplement_facts.jpg?v=1744283539";
supplementDialog.appendChild(supplementImg);
supplementDialog.insertAdjacentHTML('beforeend', '<span id="supplementFactsClose" style="position: absolute; top: 10px; right: 10px; font-size: 33px;" onclick="closeSupplementDialog()">&times;</span>');
 
document.querySelector("#supplementFacts") && document.querySelector("#supplementFacts").addEventListener("click", function(evt) {
  supplementDialog.showModal();
});    

function isInViewport(element) {
	const rect = element.getBoundingClientRect();
	return (
    	rect.top >= 0 &&
    	rect.left >= 0 &&
    	rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
    	rect.right <= (window.innerWidth || document.documentElement.clientWidth)
	);
}
 
function showBuyNowCustom() {
  let mainCTAButton = document.querySelector('#NitricAddToCart');
  let bottomContainer = document.querySelector('.bottom-button-container-marsbyghc');
	if (!isInViewport(mainCTAButton)) {
    	bottomContainer.classList.add('active')
	} else {
    	bottomContainer.classList.remove('active')
	}
}

window.addEventListener('scroll', () => {
  try{
	showBuyNowCustom();
  } catch(e) {}
});

</script>
