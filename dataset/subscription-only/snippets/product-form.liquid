  	document.querySelector(".hs-result-loading").classList.add("hs-show-loading");    
  	let quantityBuyNow = document.getElementById("js-qty-").value;    
  	jQuery.post(`${Shopify.routes.root }cart/add.js`, {    
            	items: [{    
                	quantity: document.getElementById("data-bogo").value === 'true' && quantityBuyNow && parseInt(quantityBuyNow) === 1 ? 2 : parseInt(quantityBuyNow),    
                	id: {{ product.selected_or_first_available_variant.id }},    
                	selling_plan: $("[name='selling_plan']").val() ? $("[name='selling_plan']").val() : ""    
            	}]    
        	})    
    	.then((data) => {    
      	document.querySelector(".hs-result-loading").classList.remove("hs-show-loading")	 
    	})    
	});

   document.querySelector(".product__submit__add") && document.querySelector(".product__submit__add").addEventListener("click", function() {    
  	// document.querySelector(".hs-result-loading").classList.add("hs-show-loading");
  	let quantityBuyNow = document.getElementById("js-qty-").value;    
  	jQuery.post(`${Shopify.routes.root }cart/add.js`, {    
            	items: [{    
                	quantity: document.getElementById("data-bogo").value === 'true' && quantityBuyNow && parseInt(quantityBuyNow) === 1 ? 2 : parseInt(quantityBuyNow),    
                	id: {{ product.selected_or_first_available_variant.id }},    
