<script>
  function buyNowCustom() {    
	let quantityBuyNow = document.getElementById("js-qty-").value;    
	let sellingPlan = $("[name='selling_plan']").val() ? $("[name='selling_plan']").val() : "";
	if(sellingPlan !== "") {
  	let settings = {
    	"url": "/api/2022-04/graphql.json",    
    	"method": "POST",    
    	"headers": {    
      	"X-Shopify-Storefront-Access-Token": "<Storefront Token>",    
      	"Content-Type": "application/json"    
    	},    
    	"data": JSON.stringify({    
      	query: `mutation cartCreateMutation($cartInput: CartInput) @inContext(language: ${Shopify.locale.toUpperCase()}, country: ${Shopify.country}) {cartCreate(input: $cartInput) {  cart {	id	checkoutUrl  }}}`,    
      	variables: {"cartInput":{"lines":[{"quantity":document.getElementById("data-bogo").value === 'true' && quantityBuyNow && parseInt(quantityBuyNow) === 1 ? 2 : parseInt(quantityBuyNow),"merchandiseId":"gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}","sellingPlanId":sellingPlan ? `gid://shopify/SellingPlan/${sellingPlan}` : null}]}}    
    	})    
  	};    
     	 
  	$.ajax(settings).done(function (response) {    
    	window.location.href = response.data.cartCreate.cart.checkoutUrl    
  	});    
	}
	else{
  	window.location.href = `${Shopify.routes.root }cart/{{ product.selected_or_first_available_variant.id }}:${document.getElementById("data-bogo").value === 'true' && quantityBuyNow && parseInt(quantityBuyNow) === 1 ? 2 : parseInt(quantityBuyNow)}?traffic_source=buy_now`;
	}
    
  }

   window.addEventListener('DOMContentLoaded', function() {
  	document.querySelector(".add_to_cart_button") && document.querySelector(".add_to_cart_button").addEventListener("click", function() {    
  	// document.querySelector(".hs-result-loading").classList.add("hs-show-loading");
  	let quantityBuyNow = document.getElementById("js-qty-").value;    
  	jQuery.post(`${Shopify.routes.root }cart/add.js`, {    
            	items: [{    
                	quantity: document.getElementById("data-bogo").value === 'true' && quantityBuyNow && parseInt(quantityBuyNow) === 1 ? 2 : parseInt(quantityBuyNow),    
                	id: {{ product.selected_or_first_available_variant.id }},    
                	selling_plan: $("[name='selling_plan']").val() ? $("[name='selling_plan']").val() : ""    
            	}]    
        	})    
    	.then((data) => {    
      	document.querySelector(".hs-result-loading").classList.remove("hs-show-loading")	 
    	})    
	});
   })

 window.addEventListener('DOMContentLoaded', function() {    

