{% comment %}
  Renders a product slot for the selected products section
  
  Accepts:
  - slot_number: {Number} The slot number (1-3)
  - empty_slot_text: {String} Text to display when slot is empty
  
  Usage:
  {% render 'offer-selected-product-slot', slot_number: 1, empty_slot_text: 'Select a product' %}
{% endcomment %}

<div class="offer-selected-product-slot" id="offer-slot-{{ slot_number }}">
  <div class="offer-selected-product-slot__content" style="display: none;">
    <div class="offer-selected-product-slot__image"></div>
    <div class="offer-selected-product-slot__title"></div>
    <button type="button" class="offer-selected-product-slot__remove" aria-label="Remove product" style="display: none;">
      {% render 'offer-icon-close' %}
    </button>
  </div>
  
  <div class="offer-selected-product-slot__empty">
    <div class="offer-selected-product-slot__empty-icon">{{ slot_number }}</div>
    <div class="offer-selected-product-slot__empty-text">{{ empty_slot_text }}</div>
  </div>
</div>

<style>
.offer-selected-product-slot {
  flex: 1;
  min-width: 0;
  background-color: #f9f9f9;
  border-radius: 6px;
  overflow: hidden;
  position: relative;
  height: 70px;
  transition: background-color 0.2s;
}

.offer-selected-product-slot--filled {
  background-color: #ffffff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.offer-selected-product-slot__content {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 8px;
}

.offer-selected-product-slot__image {
  width: 54px;
  height: 54px;
  border-radius: 4px;
  overflow: hidden;
  flex-shrink: 0;
}

.offer-selected-product-slot__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.offer-selected-product-slot__no-image {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.offer-selected-product-slot__title {
  margin-left: 10px;
  font-size: 0.9rem;
  font-weight: 500;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-grow: 1;
}

.offer-selected-product-slot__remove {
  background: none;
  border: none;
  color: #999;
  cursor: pointer;
  padding: 5px;
  margin-left: 5px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s, color 0.2s;
}

.offer-selected-product-slot__remove:hover {
  background-color: #f0f0f0;
  color: #ff6b6b;
}

.offer-selected-product-slot__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 8px;
}

.offer-selected-product-slot__empty-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #666;
  margin-right: 8px;
}

.offer-selected-product-slot__empty-text {
  font-size: 0.85rem;
  color: #999;
}

@media screen and (max-width: 479px) {
  .offer-selected-product-slot {
    height: 60px;
  }
  
  .offer-selected-product-slot__image {
    width: 44px;
    height: 44px;
  }
}
</style>