<div class="offer-testimonials" 
     style="background-color: {{ section.settings.background_color }}; 
            color: {{ section.settings.text_color }};">
  <div class="offer-testimonials__container page-width">
    <h2 class="offer-testimonials__heading">{{ section.settings.heading }}</h2>
    
    <div class="testimonial-container">
      <div class="testimonial-wrapper">
        <div class="testimonial-track" id="testimonial-track">
          {% for block in section.blocks %}
            {% if block.type == 'testimonial' %}
              <div class="testimonial-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
                <div class="testimonial-content">
                  <div class="testimonial-quote-mark">"</div>
                  <blockquote>{{ block.settings.quote }}</blockquote>
                  <footer>— {{ block.settings.author }}</footer>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      
      <div class="testimonial-controls">
        <button class="testimonial-prev" aria-label="Previous testimonial">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="testimonial-next" aria-label="Next testimonial">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality exceeded my expectations! Perfect holiday gift."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Promotional",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.offer-testimonials {
  padding: 60px 0;
}

.offer-testimonials__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  position: relative;
}

.offer-testimonials__heading {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 40px;
  font-weight: 700;
}

/* New clean testimonial slider styles */
.testimonial-container {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0;
}

.testimonial-wrapper {
  overflow: hidden;
  position: relative;
  margin-bottom: 30px;
}

.testimonial-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
}

.testimonial-slide {
  flex: 0 0 100%;
  width: 100%;
  padding: 10px;
  opacity: 0.4;
  transform: scale(0.9);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.testimonial-slide.active {
  opacity: 1;
  transform: scale(1);
}

.testimonial-content {
  background-color: white;
  border-radius: 12px;
  padding: 40px 30px 30px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08), 0 1.5px 4px rgba(0,0,0,0.04);
  position: relative;
  text-align: center;
}

.testimonial-quote-mark {
  position: absolute;
  top: 20px;
  left: 25px;
  font-size: 48px;
  font-family: serif;
  color: #e0e0e0;
  opacity: 0.5;
  line-height: 1;
}

.testimonial-content blockquote {
  font-size: 1.2rem;
  line-height: 1.6;
  font-style: italic;
  color: #222;
  margin: 0 0 20px 0;
  z-index: 1;
  position: relative;
}

.testimonial-content footer {
  font-weight: 600;
  color: #666;
  font-size: 1rem;
}

.testimonial-controls {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
}

.testimonial-prev,
.testimonial-next {
  background: white;
  border: 1px solid #ddd;
  border-radius: 50%;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  transition: all 0.2s ease;
}

.testimonial-prev:hover,
.testimonial-next:hover {
  background: #f5f5f5;
  border-color: #aaa;
}

.testimonial-prev svg,
.testimonial-next svg {
  width: 24px;
  height: 24px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const track = document.getElementById('testimonial-track');
  const slides = track ? track.querySelectorAll('.testimonial-slide') : [];
  const prevButton = document.querySelector('.testimonial-prev');
  const nextButton = document.querySelector('.testimonial-next');
  
  if (!track || slides.length <= 1) return;
  
  let currentIndex = 0;
  let autoplayInterval;
  
  // Initialize slider
  function initializeSlider() {
    updateSlides();
    startAutoplay();
  }
  
  // Update slide positions and active states
  function updateSlides() {
    // Position all slides with transform
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    // Update active classes for animation
    slides.forEach((slide, index) => {
      slide.classList.toggle('active', index === currentIndex);
    });
  }
  
  // Navigation functions
  function goToSlide(index) {
    currentIndex = (index + slides.length) % slides.length;
    updateSlides();
    restartAutoplay();
  }
  
  function goToPrev() {
    goToSlide(currentIndex - 1);
  }
  
  function goToNext() {
    goToSlide(currentIndex + 1);
  }
  
  // Autoplay functions
  function startAutoplay() {
    autoplayInterval = setInterval(goToNext, 5000);
  }
  
  function restartAutoplay() {
    clearInterval(autoplayInterval);
    startAutoplay();
  }
  
  // Event listeners
  if (prevButton) {
    prevButton.addEventListener('click', goToPrev);
  }
  
  if (nextButton) {
    nextButton.addEventListener('click', goToNext);
  }
  
  // Initialize the slider
  initializeSlider();
});
</script>