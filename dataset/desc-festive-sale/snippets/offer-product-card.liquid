<div class="offer-product-card">
  <a href="{{ product.url }}" class="offer-product-card__link">
    <div class="offer-product-card__image-wrapper">
      {% if product.featured_image != blank %}
        <img src="{{ product.featured_image | img_url: '400x' }}" 
             alt="{{ product.featured_image.alt | escape }}"
             class="offer-product-card__image"
             loading="lazy"
             width="{{ product.featured_image.width }}"
             height="{{ product.featured_image.height }}">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'offer-product-card__image placeholder' }}
      {% endif %}
      
      {% if show_sale_badge and product.compare_at_price > product.price %}
        {% render 'offer-sale-badge' %}
      {% endif %}
    </div>
    
    <div class="offer-product-card__info">
      <h3 class="offer-product-card__title">{{ product.title }}</h3>
      
      <div class="offer-product-card__price">
        <span class="offer-product-card__price-current">{{ product.price | money }}</span>
        
        {% if product.compare_at_price > product.price %}
          <span class="offer-product-card__price-compare">{{ product.compare_at_price | money }}</span>
          
          {% if show_discount_tag %}
            {% assign discount_amount = product.compare_at_price | minus: product.price %}
            {% assign discount_percentage = discount_amount | times: 100 | divided_by: product.compare_at_price %}
            {% render 'offer-discount-tag', text: discount_percentage | append: '% OFF' %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </a>
  
  <div class="offer-product-card__actions">
    <form method="post" action="/cart/add" class="offer-product-card__form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="offer-product-card__add-to-cart button"
              {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>
    </form>
  </div>
</div>

<style>
.offer-product-card {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.offer-product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

.offer-product-card__link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.offer-product-card__image-wrapper {
  position: relative;
  padding-bottom: 100%;
  overflow: hidden;
}

.offer-product-card__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.offer-product-card:hover .offer-product-card__image {
  transform: scale(1.05);
}

.offer-product-card__info {
  padding: 15px;
  flex-grow: 1;
}

.offer-product-card__title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 10px;
  line-height: 1.3;
}

.offer-product-card__price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.offer-product-card__price-current {
  font-weight: 700;
  font-size: 1.1rem;
  color: #cc0000;
}

.offer-product-card__price-compare {
  text-decoration: line-through;
  color: #999999;
  font-size: 0.9rem;
}

.offer-product-card__actions {
  padding: 0 15px 15px;
}

.offer-product-card__add-to-cart {
  width: 100%;
  padding: 10px;
  background-color: #333333;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.offer-product-card__add-to-cart:hover:not([disabled]) {
  background-color: #555555;
}

.offer-product-card__add-to-cart[disabled] {
  background-color: #cccccc;
  cursor: not-allowed;
}

.placeholder {
  background-color: #f5f5f5;
}
</style>