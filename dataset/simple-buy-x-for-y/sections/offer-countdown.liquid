<div class="offer-countdown-section" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="countdown-heading" style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="countdown-container" style="color: {{ section.settings.text_color }}; --accent-color: {{ section.settings.accent_color }};">
      {% assign timer_id = 'offer-countdown-timer' %}
      {% assign end_date = section.settings.end_date %}
      {% render 'offer-timer', timer_id: timer_id, end_date: end_date %}
    </div>
  </div>
</div>

<style>
  .offer-countdown-section {
    padding: 30px 20px;
    text-align: center;
  }
  
  .countdown-heading {
    margin: 0 0 20px;
    font-size: 24px;
    font-weight: 600;
  }
  
  .countdown-container {
    max-width: 500px;
    margin: 0 auto;
  }
  
  .offer-timer {
    display: flex;
    justify-content: center;
    gap: 15px;
  }
  
  .timer-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 70px;
  }
  
  .timer-value {
    font-size: 32px;
    font-weight: 700;
    background-color: var(--accent-color);
    color: white;
    border-radius: 5px;
    padding: 10px 0;
    width: 100%;
    display: block;
    margin-bottom: 5px;
  }
  
  .timer-label {
    font-size: 14px;
    text-transform: uppercase;
    font-weight: 500;
  }
  
  @media screen and (max-width: 749px) {
    .offer-countdown-section {
      padding: 20px 15px;
    }
    
    .countdown-heading {
      font-size: 20px;
    }
    
    .timer-block {
      min-width: 60px;
    }
    
    .timer-value {
      font-size: 24px;
      padding: 8px 0;
    }
    
    .timer-label {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Offer Countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Offer Ends In:"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date (YYYY-MM-DDThh:mm:ss)",
      "default": "2025-05-09T23:59:59",
      "info": "Format: YYYY-MM-DDThh:mm:ss (e.g., 2025-05-09T23:59:59)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4d4d"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Offer Countdown",
      "category": "Custom"
    }
  ]
}
{% endschema %}