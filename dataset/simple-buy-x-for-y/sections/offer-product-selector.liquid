<div class="offer-product-selector" 
     id="offer-product-selector"
     style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
     data-max-selections="3">
  <div class="page-width">
    <div class="selection-status">
      <span id="selection-count">0</span>/3 products selected
    </div>
    
    <div class="products-grid" style="--products-per-row: {{ section.settings.products_per_row }};">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% assign max_products = section.settings.products_per_row | times: section.settings.max_rows %}
        {% assign product_limit = collection.products.size %}
        {% if product_limit > max_products %}
          {% assign product_limit = max_products %}
        {% endif %}
        
        {% for product in collection.products limit: product_limit %}
          {% if product.available %}
            {% render 'offer-product-card', 
              product: product, 
              selected: false, 
              show_vendor: section.settings.show_vendor, 
              show_price: section.settings.show_price,
              selected_border_color: section.settings.selected_border_color
            %}
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="no-products-message">
          No products found in the selected collection.
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .offer-product-selector {
    padding: 40px 20px;
  }
  
  .selection-status {
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 30px;
  }
  
  #selection-count {
    font-size: 24px;
    color: {{ section.settings.selected_border_color }};
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(var(--products-per-row), 1fr);
    gap: 20px;
    margin: 0 auto;
  }
  
  .no-products-message {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
    background: #f8f8f8;
    border-radius: 5px;
  }
  
  .offer-product-card {
    cursor: pointer;
  }
  
  .product-card-inner {
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .product-card-inner.selected {
    border-color: var(--selected-border-color);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }
  
  .product-card-image-container {
    position: relative;
    padding-bottom: 100%;
    overflow: hidden;
  }
  
  .product-card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .offer-product-card:hover .product-card-image {
    transform: scale(1.05);
  }
  
  .product-card-selection-indicator {
    position: absolute;
    top: 10px;
    right: 10px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .product-card-inner.selected .product-card-selection-indicator {
    opacity: 1;
  }
  
  .selection-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--selected-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
  
  .product-card-info {
    padding: 15px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  
  .product-card-title {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  
  .product-card-vendor {
    font-size: 14px;
    color: #666;
    margin-bottom: 8px;
  }
  
  .product-card-price {
    font-size: 16px;
    font-weight: 600;
    margin-top: auto;
  }
  
  @media screen and (max-width: 989px) {
    .products-grid {
      --products-per-row: 2;
    }
  }
  
  @media screen and (max-width: 749px) {
    .offer-product-selector {
      padding: 30px 15px;
    }
    
    .selection-status {
      font-size: 16px;
      margin-bottom: 20px;
    }
    
    #selection-count {
      font-size: 20px;
    }
    
    .product-card-title {
      font-size: 14px;
    }
    
    .product-card-price {
      font-size: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const productSelector = document.getElementById('offer-product-selector');
    const maxSelections = parseInt(productSelector.dataset.maxSelections) || 3;
    const selectionCountElement = document.getElementById('selection-count');
    const productCards = document.querySelectorAll('.offer-product-card');
    
    // Initialize selected products array
    window.selectedProducts = [];
    
    // Update selection count display
    function updateSelectionCount() {
      selectionCountElement.textContent = window.selectedProducts.length;
      
      // Dispatch custom event when selection changes
      const event = new CustomEvent('offer:selection-changed', {
        detail: {
          selectedProducts: window.selectedProducts,
          isComplete: window.selectedProducts.length === maxSelections
        }
      });
      document.dispatchEvent(event);
    }
    
    // Handle product selection
    productCards.forEach(card => {
      card.addEventListener('click', function() {
        const productId = this.dataset.productId;
        const cardInner = this.querySelector('.product-card-inner');
        const isSelected = cardInner.classList.contains('selected');
        
        // If already selected, remove from selection
        if (isSelected) {
          cardInner.classList.remove('selected');
          window.selectedProducts = window.selectedProducts.filter(p => p.id !== productId);
        } 
        // If not selected and haven't reached max, add to selection
        else if (window.selectedProducts.length < maxSelections) {
          cardInner.classList.add('selected');
          window.selectedProducts.push({
            id: productId,
            handle: this.dataset.productHandle,
            title: this.dataset.productTitle,
            price: this.dataset.productPrice,
            image: this.dataset.productImage,
            url: this.dataset.productUrl,
            variantId: this.dataset.variantId
          });
        }
        // If trying to select more than max, show message
        else {
          const existingAlert = document.querySelector('.max-selection-alert');
          if (!existingAlert) {
            const alert = document.createElement('div');
            alert.className = 'max-selection-alert';
            alert.textContent = `You can only select ${maxSelections} products. Please deselect one before adding another.`;
            alert.style.position = 'fixed';
            alert.style.top = '20px';
            alert.style.left = '50%';
            alert.style.transform = 'translateX(-50%)';
            alert.style.backgroundColor = '#ff4d4d';
            alert.style.color = 'white';
            alert.style.padding = '15px 20px';
            alert.style.borderRadius = '5px';
            alert.style.zIndex = '1000';
            alert.style.boxShadow = '0 5px 15px rgba(0,0,0,0.2)';
            document.body.appendChild(alert);
            
            setTimeout(() => {
              alert.remove();
            }, 3000);
          }
        }
        
        updateSelectionCount();
      });
    });
  });
</script>

{% schema %}
{
  "name": "Offer Product Selector",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Products per row"
    },
    {
      "type": "range",
      "id": "max_rows",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Maximum rows"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "selected_border_color",
      "label": "Selected Product Border Color",
      "default": "#ff4d4d"
    }
  ],
  "presets": [
    {
      "name": "Offer Product Selector",
      "category": "Custom"
    }
  ]
}
{% endschema %}